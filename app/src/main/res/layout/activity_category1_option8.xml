<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".Category1Option8Activity">

    <TextView
        android:id="@+id/optionsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/calc_rental_property"
        android:textColor="@color/text_primary"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/scrollView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="350dp"
        android:layout_height="350dp"
        app:layout_constraintBottom_toTopOf="@id/calculateButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/optionsTitle">

        <LinearLayout
            android:id="@+id/optionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@color/text_fourth"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/purchase"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/purchasePrice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/purchase_price"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color" />

            <RadioGroup
                android:id="@+id/radioGroupUseLoan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/use_loan"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp">

                </TextView>

                <RadioButton
                    android:id="@+id/radioUseLoanYes"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/yes"
                    android:textColor="@color/text_primary"
                    app:buttonTint="@color/text_third" />

                <RadioButton
                    android:id="@+id/radioUseLoanNo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/no"
                    android:textColor="@color/text_primary"
                    app:buttonTint="@color/text_third" />
            </RadioGroup>

            <EditText
                android:id="@+id/downPayment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/down_payment_percent"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:visibility="visible" />

            <EditText
                android:id="@+id/interestRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/interest_rate"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:visibility="visible" />

            <EditText
                android:id="@+id/loanTerm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/loan_term"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:visibility="visible" />

            <EditText
                android:id="@+id/closingCosts"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/closing_cost_dollar"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color" />

            <RadioGroup
                android:id="@+id/radioGroupNeedRepairs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/need_repairs"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp">

                </TextView>

                <RadioButton
                    android:id="@+id/radioNeedRepairYes"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/yes"
                    android:textColor="@color/text_primary"
                    app:buttonTint="@color/text_third" />

                <RadioButton
                    android:id="@+id/radioNeedRepairNo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/no"
                    android:textColor="@color/text_primary"
                    app:buttonTint="@color/text_third" />
            </RadioGroup>

            <EditText
                android:id="@+id/repairCosts"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/repair_cost"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:visibility="gone"
                tools:ignore="DuplicateSpeakableTextCheck"
                tools:visibility="visible" />


            <EditText
                android:id="@+id/afterRepairs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/value_after_repairs"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@color/text_fourth"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/recurring_operating_expenses"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/annual"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:text="@string/annual_increase"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/propertyTaxes"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/property_tax"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                    <EditText
                        android:id="@+id/propertyTaxesIncrease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/percent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color"
                        tools:ignore="DuplicateSpeakableTextCheck" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/totalInsurance"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/total_insurance"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                    <EditText
                        android:id="@+id/totalInsuranceIncrease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/percent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/hoaFee"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/hoa_fee_dollar"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                    <EditText
                        android:id="@+id/hoaFeeIncrease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/percent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color"
                        tools:ignore="DuplicateSpeakableTextCheck" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/maintenance"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/maintenance"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                    <EditText
                        android:id="@+id/maintenanceIncrease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/percent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/otherCosts"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/other_costs"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                    <EditText
                        android:id="@+id/otherCostsIncrease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/percent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/text_fourth"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/income"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:ignore="DuplicateIds">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:text="@string/annual_increase"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/monthlyRent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/monthly_rent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                    <EditText
                        android:id="@+id/monthlyRentIncrease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/percent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color"
                        tools:ignore="DuplicateSpeakableTextCheck" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/otherIncome"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/other_monthly_income"
                        android:textSize="16sp"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                    <EditText
                        android:id="@+id/otherIncomeIncrease"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_text_border"
                        android:ems="10"
                        android:gravity="center_vertical"
                        android:hint="@string/percent"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint_color" />

                </LinearLayout>

            </LinearLayout>

            <EditText
                android:id="@+id/vacancyRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/vacancy_rate"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color" />

            <EditText
                android:id="@+id/managementFee"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/management_fee"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/text_fourth"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/sell"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupKnowSellPrice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/do_you_know_the_sell_price"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp">

                </TextView>

                <RadioButton
                    android:id="@+id/radioKnowSellPriceYes"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/yes"
                    android:textColor="@color/text_primary"
                    app:buttonTint="@color/text_third" />

                <RadioButton
                    android:id="@+id/radioKnowSellPriceNo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/no"
                    android:textColor="@color/text_primary"
                    app:buttonTint="@color/text_third" />
            </RadioGroup>

            <EditText
                android:id="@+id/valueAppreciation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/value_appreciation_per_year"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:visibility="visible"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/sellPrice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/sell_price"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color"
                android:visibility="gone"
                tools:visibility="visible" />


            <EditText
                android:id="@+id/holdingLength"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/holding_length_year"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color" />
            <EditText
                android:id="@+id/costToSell"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/edit_text_border"
                android:ems="10"
                android:gravity="center_vertical"
                android:hint="@string/cost_to_sell"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint_color" />

            <TextView
                android:id="@+id/resultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:typeface="monospace"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/calculateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        android:backgroundTint="@color/button_calculate"
        android:text="@string/calculate_button"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollView" />


    <ImageView
        android:id="@+id/logo"
        android:layout_width="67dp"
        android:layout_height="73dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="-5dp"
        android:alpha=".5"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/logo"
        tools:ignore="ImageContrastCheck,VisualLintBounds" />
</androidx.constraintlayout.widget.ConstraintLayout>
